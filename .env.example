# These two are added automatically when you connect a Turso database
# to the Vercel project through Storage / Marketplace.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Added automatically when you connect a PUBLIC Vercel Blob store.
BLOB_READ_WRITE_TOKEN=

# Optional until you are ready to sign in. Add these three in Vercel, not GitHub.
# They create the first owner only when the owners table is empty.
JAGHVI_OWNER_ID=
JAGHVI_OWNER_EMAIL=
JAGHVI_OWNER_PASSWORD=

# Optional. Defaults already allow *.vercel.app and jaghvi.com.
# ALLOWED_HOSTS=*.vercel.app,jaghvi.com,*.jaghvi.com
